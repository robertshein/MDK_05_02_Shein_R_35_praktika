<Page x:Class="PermDynamics_Shein.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PermDynamics_Shein.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="782"
      Title="Main">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="34*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/chart.jpg"/>
        </Grid.Background>
        <Label Content="PermDynamics" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" 
               Margin="113,279,103,73"
               Width="261"
               Height="58"
               Foreground="White"
               FontSize="36"
               FontWeight="Bold"/>
        <Image HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="121,179,256,131"
               Width="100"
               Height="100"
               Source="/Images/icon-white.png"/>
        <Label Content="Укажите начальное значение акции:"
               Grid.Column="1"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="12,191,82,193"
               Foreground="White"
               Height="26"/>
        <TextBox x:Name="tb_value" 
                 Grid.Column="1" 
                 VerticalAlignment="Center" 
                 VerticalContentAlignment="Center"
                 HorizontalAlignment="Center" 
                 Margin="12,217,10,168" 
                 Height="25"
                 Width="283"
                 TextWrapping="Wrap"/>
        <Button Click="OpenPageChart"
                Content="Продолжить"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="195,247,10,137"
                Height="25"
                Width="100"
                Background="White"
                BorderBrush="Black"/>

    </Grid>
</Page>
